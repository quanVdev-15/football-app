rules_version = '2';
// TODO: tighten all admin-write rules with Firebase Auth once phone/email auth is added.
// For now the client enforces a PIN check; Firestore stays open to trusted clients.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Players list ───────────────────────────────────────────────────────────
    // Public read (player name dropdown). Write open so admin can add players.
    match /players/{playerId} {
      allow read: if true;
      allow write: if true; // TODO: restrict to admin auth
    }

    // ── Config ─────────────────────────────────────────────────────────────────
    // Public read (to fetch currentSessionId, maxCap).
    // Write open for now — admin PIN check is enforced on the client.
    match /config/{doc} {
      allow read: if true;
      allow write: if true; // TODO: restrict to admin auth
    }

    // Monthly subscription payments.
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow write: if true; // TODO: restrict admin-only fields once real auth is added
    }

    // ── Sessions ───────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      // Anyone can read session metadata (date, status, maxCap)
      allow read: if true;
      // TODO: restrict to admin auth
      allow write: if true;

      // Votes — anyone can write their own vote (going / not_going)
      match /votes/{playerName} {
        allow read: if true;
        allow write: if true; // cap enforcement is done in app.js client logic
      }

      // RSVPs — current app flow stores attendance here.
      match /rsvps/{playerId} {
        allow read: if true;
        allow write: if true; // TODO: restrict/validate once real auth is added
      }

      // Payments — players self-report, admins confirm via the PIN-gated UI.
      match /payments/{playerId} {
        allow read: if true;
        allow write: if true; // TODO: restrict admin-only fields once real auth is added
      }

      // Teams — public read so all players see the result in real-time
      match /teams/{teamId} {
        allow read: if true;
        allow write: if true; // TODO: restrict to admin auth
      }
    }

    // Debts carried across sessions.
    match /debts/{debtId} {
      allow read: if true;
      allow write: if true; // TODO: restrict to admin auth
    }

    // Friendly match events.
    match /events/{eventId} {
      allow read: if true;
      allow write: if true; // TODO: restrict admin fields once auth is added
      match /rsvps/{playerId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}
